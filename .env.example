# Copy this file to .env and paste your Gemini API key after the equals sign.
# Keep .env private. Never put your API key directly in app.py or publish it.
GEMINI_API_KEY=
# Optional: enables the multi-model review toggle.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5
